FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy project files
COPY ["src/JIR.BlazorApp/JIR.BlazorApp.csproj", "JIR.BlazorApp/"]

# Restore dependencies (cached)
RUN dotnet restore "JIR.BlazorApp/JIR.BlazorApp.csproj"

# Copy source and build using cached restore
COPY src/JIR.BlazorApp/ JIR.BlazorApp/
WORKDIR "/src/JIR.BlazorApp"
RUN dotnet build "JIR.BlazorApp.csproj" -c Release -o /app/build --no-restore

# Publish (no build)
FROM build AS publish
RUN dotnet publish "JIR.BlazorApp.csproj" -c Release -o /app/publish /p:UseAppHost=false --no-build

# Runtime
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
# Expose only the app port
EXPOSE 8080
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "JIR.BlazorApp.dll"]
