@page "/articles"
@using JIR.BlazorApp.Models
@using JIR.BlazorApp.Services
@inject ArticleMagasinService ArticleService
@inject MagasinService MagasinService
@inject ToastService ToastService
@inject ConfirmDialogService ConfirmDialogService
@rendermode InteractiveServer

<h3>Gestion des Articles</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowCreateForm">
        <span class="oi oi-plus"></span> Nouvel Article
    </button>
</div>

@if (showForm)
{
    <div class="card mb-3">
        <div class="card-header">
            @(isEdit ? "Modifier Article" : "Nouvel Article")
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Code Article <span class="text-danger">*</span></label>
                <input type="text" class="form-control @(formValidated && string.IsNullOrWhiteSpace(formCodeArticle) ? "is-invalid" : "")" @bind="formCodeArticle" disabled="@isEdit" required />
                @if (formValidated && string.IsNullOrWhiteSpace(formCodeArticle))
                {
                    <div class="invalid-feedback">Le code article est requis.</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Désignation <span class="text-danger">*</span></label>
                <input type="text" class="form-control @(formValidated && string.IsNullOrWhiteSpace(formDesignation) ? "is-invalid" : "")" @bind="formDesignation" required />
                @if (formValidated && string.IsNullOrWhiteSpace(formDesignation))
                {
                    <div class="invalid-feedback">La désignation est requise.</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Unité <span class="text-danger">*</span></label>
                <input type="text" class="form-control @(formValidated && string.IsNullOrWhiteSpace(formUnite) ? "is-invalid" : "")" @bind="formUnite" placeholder="Ex: kg, L, unité..." required />
                @if (formValidated && string.IsNullOrWhiteSpace(formUnite))
                {
                    <div class="invalid-feedback">L'unité est requise.</div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">Magasin <span class="text-danger">*</span></label>
                <select class="form-select @(formValidated && string.IsNullOrEmpty(formMagasinId) ? "is-invalid" : "")" @bind="formMagasinId" disabled="@isEdit" required>
                    <option value="">-- Sélectionner un magasin --</option>
                    @if (magasins != null)
                    {
                        @foreach (var mag in magasins.Magasins)
                        {
                            <option value="@mag.Id">@mag.Nom</option>
                        }
                    }
                </select>
                @if (formValidated && string.IsNullOrEmpty(formMagasinId))
                {
                    <div class="invalid-feedback">Le magasin est requis.</div>
                }
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Prix Unitaire <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" class="form-control @(formValidated && formPrixUnitaire < 0 ? "is-invalid" : "")" @bind="formPrixUnitaire" min="0" required />
                    @if (formValidated && formPrixUnitaire < 0)
                    {
                        <div class="invalid-feedback">Le prix doit être positif.</div>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label">Seuil Minimum <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" class="form-control @(formValidated && formSeuilAlerte < 0 ? "is-invalid" : "")" @bind="formSeuilAlerte" min="0" required />
                    @if (formValidated && formSeuilAlerte < 0)
                    {
                        <div class="invalid-feedback">Le seuil doit être positif.</div>
                    }
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success" @onclick="SaveArticle">Enregistrer</button>
                <button class="btn btn-secondary" @onclick="CancelForm">Annuler</button>
            </div>
        </div>
    </div>
}

@if (loading)
{
    <p><em>Chargement...</em></p>
}
else if (articles != null)
{
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Rechercher..." @bind="searchTerm" @bind:event="oninput" @onkeyup="SearchArticles" />
        </div>
        <div class="col-md-6">
            <select class="form-select" @bind="filterMagasinId" @bind:after="FilterByMagasin">
                <option value="">Tous les magasins</option>
                @if (magasins != null)
                {
                    @foreach (var mag in magasins.Magasins)
                    {
                        <option value="@mag.Id">@mag.Nom</option>
                    }
                }
            </select>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Désignation</th>
                <th>Magasin</th>
                <th>Stock</th>
                <th>Seuil Min</th>
                <th>Prix Unit.</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in articles.Articles)
            {
                <tr class="@(article.QuantiteStock <= article.SeuilAlerte ? "table-warning" : "")">
                    <td>@article.CodeArticle</td>
                    <td>@article.Designation</td>
                    <td>@article.MagasinNom</td>
                    <td>@article.QuantiteStock.ToString("N2")</td>
                    <td>@article.SeuilAlerte.ToString("N2")</td>
                    <td>@article.PrixUnitaire.ToString("C2")</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => EditArticle(article)">Modifier</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteArticle(article.Id)">Supprimer</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= articles.TotalPages; i++)
            {
                var pageNum = i;
                <li class="page-item @(pageNum == currentPage ? "active" : "")">
                    <a class="page-link" @onclick="() => LoadArticles(pageNum)">@pageNum</a>
                </li>
            }
        </ul>
    </nav>
}

@code {
    private ArticlesMagasinListResult? articles;
    private MagasinsListResult? magasins;
    private bool loading = true;
    private bool showForm = false;
    private bool isEdit = false;
    private Guid? editId = null;
    private int currentPage = 1;
    private string searchTerm = "";
    private string filterMagasinId = "";

    // Form fields
    private string formCodeArticle = "";
    private string formDesignation = "";
    private string formUnite = "";
    private string formMagasinId = "";
    private decimal formPrixUnitaire = 0;
    private decimal formSeuilAlerte = 0;
    private bool formValidated = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadMagasins();
        await LoadArticles();
    }

    private async Task LoadMagasins()
    {
        magasins = await MagasinService.GetAllAsync(1, 100);
    }

    private async Task LoadArticles(int page = 1)
    {
        loading = true;
        currentPage = page;
        Guid? magasinFilter = string.IsNullOrEmpty(filterMagasinId) ? null : Guid.Parse(filterMagasinId);
        articles = await ArticleService.GetAllAsync(page, 10, magasinFilter, string.IsNullOrEmpty(searchTerm) ? null : searchTerm);
        loading = false;
    }

    private async Task SearchArticles()
    {
        await LoadArticles(1);
    }

    private async Task FilterByMagasin()
    {
        await LoadArticles(1);
    }

    private void ShowCreateForm()
    {
        isEdit = false;
        editId = null;
        formCodeArticle = "";
        formDesignation = "";
        formUnite = "";
        formMagasinId = "";
        formPrixUnitaire = 0;
        formSeuilAlerte = 0;
        formValidated = false;
        showForm = true;
    }

    private void EditArticle(ArticleMagasinDto article)
    {
        isEdit = true;
        editId = article.Id;
        formCodeArticle = article.CodeArticle;
        formDesignation = article.Designation;
        formUnite = article.Unite;
        formMagasinId = article.MagasinId.ToString();
        formPrixUnitaire = article.PrixUnitaire;
        formSeuilAlerte = article.SeuilAlerte;
        formValidated = false;
        showForm = true;
    }

    private async Task SaveArticle()
    {
        formValidated = true;

        // Validation
        if (string.IsNullOrWhiteSpace(formCodeArticle) || 
            string.IsNullOrWhiteSpace(formDesignation) || 
            string.IsNullOrWhiteSpace(formUnite) || 
            string.IsNullOrEmpty(formMagasinId) || 
            formPrixUnitaire < 0 || 
            formSeuilAlerte < 0)
        {
            ToastService.ShowWarning("Veuillez remplir tous les champs obligatoires correctement", "Validation");
            return;
        }

        try
        {
            if (isEdit && editId.HasValue)
            {
                await ArticleService.UpdateAsync(editId.Value, new UpdateArticleMagasinRequest
                {
                    CodeArticle = formCodeArticle,
                    Designation = formDesignation,
                    Unite = formUnite,
                    PrixUnitaire = formPrixUnitaire,
                    SeuilAlerte = formSeuilAlerte
                });
                ToastService.ShowSuccess("Article modifié avec succès!");
            }
            else
            {
                await ArticleService.CreateAsync(new CreateArticleMagasinRequest
                {
                    CodeArticle = formCodeArticle,
                    Designation = formDesignation,
                    Unite = formUnite,
                    MagasinId = Guid.Parse(formMagasinId),
                    PrixUnitaire = formPrixUnitaire,
                    SeuilAlerte = formSeuilAlerte
                });
                ToastService.ShowSuccess("Article créé avec succès!");
            }

            formValidated = false;
            showForm = false;
            await LoadArticles(currentPage);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erreur lors de l'enregistrement: {ex.Message}");
        }
    }

    private void CancelForm()
    {
        showForm = false;
    }

    private async Task DeleteArticle(Guid id)
    {
        var confirmed = await ConfirmDialogService.ShowAsync(
            "Confirmer la suppression",
            "Êtes-vous sûr de vouloir supprimer cet article ? Cette action est irréversible.",
            "Supprimer"
        );

        if (!confirmed)
            return;

        try
        {
            await ArticleService.DeleteAsync(id);
            ToastService.ShowSuccess("Article supprimé avec succès!");
            await LoadArticles(currentPage);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erreur lors de la suppression: {ex.Message}");
        }
    }
}
