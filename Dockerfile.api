FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy all project files
COPY ["src/JIR.WebAPI/JIR.WebAPI.csproj", "JIR.WebAPI/"]
COPY ["src/JIR.Application/JIR.Application.csproj", "JIR.Application/"]
COPY ["src/JIR.Domain/JIR.Domain.csproj", "JIR.Domain/"]
COPY ["src/JIR.Infrastructure/JIR.Infrastructure.csproj", "JIR.Infrastructure/"]

# Restore dependencies (cached)
RUN dotnet restore "JIR.WebAPI/JIR.WebAPI.csproj"

# Copy source and build using cached restore
COPY src/ .
WORKDIR "/src/JIR.WebAPI"
# First build (no restore to use cache)
RUN dotnet build "JIR.WebAPI.csproj" -c Release -o /app/build --no-restore

# Publish (no build, use the compiled outputs)
FROM build AS publish
RUN dotnet publish "JIR.WebAPI.csproj" -c Release -o /app/publish /p:UseAppHost=false --no-build

# Runtime
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
# Expose only the app port
EXPOSE 8080
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "JIR.WebAPI.dll"]
